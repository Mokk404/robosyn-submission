*.pt
*.pth
*.bin
*.onnx
*.npy
*.npz
*.parquet

# Evaluation videos are evidence artifacts, not source code.
*.mp4
*.webm
*.mov
*.m4v

# Local archives
*.zip
*.tar
*.tar.gz
*.tgz

